{
  "expo": {
    "name": "Heartwood",
    "slug": "heartwood-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "heartwood",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#1a3d28",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.heartwood.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.heartwood.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

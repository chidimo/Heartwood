{
  "cli": { "version": ">= 15.0.14", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "distribution": "store",
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": { "production": {} }
}

{
  "name": "database",
  "projectType": "library",
  "sourceRoot": "packages/database/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "npx tsc -p tsconfig.json", "cwd": "packages/database" }
    },
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "kysely-codegen --out-file src/db.types.ts --env-file ../../apps/backend/.env",
        "cwd": "packages/database"
      }
    }
  }
}

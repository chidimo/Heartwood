{
  "name": "heartwood",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/backend",
    "apps/web"
  ],
  "scripts": {
    "dev": "nx run-many -t start dev --projects=backend,web --parallel",
    "backend:start": "nx run backend:start",
    "backend:build": "yarn packages:build && nx run backend:build",
    "packages:build": "nx run-many -t build --projects=database,shared",
    "web:dev": "nx run web:dev",
    "web:build": "nx run web:build",
    "web:test": "yarn --cwd apps/web test",
    "web:lint": "yarn --cwd apps/web lint",
    "db:codegen": "nx run database:codegen",
    "db:migrate": "nx run backend:migrate",
    "db:migration:create": "nx run backend:migration:create",
    "typecheck": "nx run-many -t typecheck --projects=backend,web",
    "test:backend": "./scripts/test-backend.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mobile:start": "yarn --cwd apps/mobile start",
    "mobile:ios": "yarn --cwd apps/mobile ios",
    "mobile:android": "yarn --cwd apps/mobile android",
    "mobile:typecheck": "yarn --cwd apps/mobile typecheck",
    "mobile:test": "yarn --cwd apps/mobile test",
    "mobile:lint": "yarn --cwd apps/mobile lint",
    "db:seed": "nx run backend:seed",
    "db:reset": "nx run backend:reset"
  },
  "devDependencies": {
    "@nx/eslint": "22.4.4",
    "@nx/js": "22.4.4",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.25.0",
    "jest": "^30.4.2",
    "kysely-codegen": "^0.20.0",
    "nx": "22.4.4",
    "prettier": "~3.6.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.4",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.2",
    "morgan": "^1.10.1",
    "pg": "^8.16.2",
    "zod": "^3.23.0"
  }
}
